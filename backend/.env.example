# Database connection string (PostgreSQL for Supabase)
DATABASE_URL=postgresql+psycopg2://postgres:[password]@[db-host]:5432/postgres

# Security keys (Generate secure values for production)
SECRET_KEY=super_secure_random_access_token_secret_key_change_me
REFRESH_TOKEN_SECRET_KEY=super_secure_random_refresh_token_secret_key_change_me
ALGORITHM=HS256

# Token expirations
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS allowed origins (comma separated list)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# Rate Limiting parameters
RATE_LIMIT_LIMIT=60/minute
